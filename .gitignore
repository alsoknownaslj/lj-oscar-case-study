# data: raw and derived stay local (GitHub 100MB limit; see CLAUDE.md "Base tables")
data/raw/*
!data/raw/README.md
!data/raw/ccs.csv
data/cache/*
!data/cache/.gitkeep
data/processed/*
!data/processed/.gitkeep

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# duckdb scratch databases
*.duckdb
*.duckdb.wal

# os / editor (keep the shared extension recommendations)
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# secrets / local env (never commit credentials)
.env
.env.*
!.env.example

# claude code: per-user local settings stay out; shared settings.json is committed
.claude/settings.local.json

# more python tool caches
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.virtual_documents/

# session logs and exports go to chat, never the repo (Lauren, 2026-11-02)
*session-export*
*session-log*

# more os / editor noise
Thumbs.db
*.swp
*~
